# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored. Never commit real credentials.
# Everything in this file is server-side only and must never reach the browser.

# --- Server ---
PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=50

# --- Supabase ---
# Leave both blank for local development: data is kept in backend/.data/ and
# authentication is disabled.
SUPABASE_URL=
# Secret key: bypasses Row Level Security. Backend only.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=evidence

# --- Production AI: Nebius Token Factory + NVIDIA Nemotron ---
# This is the only AI inference provider. While NEBIUS_API_KEY or NEBIUS_MODEL is
# blank, production AI is reported as "not configured" and verification is disabled.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Exact NVIDIA Nemotron model id from your Nebius Token Factory console
NEBIUS_MODEL=

# --- DEV ONLY ---
# true = use a deterministic fixture in place of AI so the verification loop can be
# exercised without a Nebius key. It does NOT inspect files and is NOT AI inference;
# every result is labelled as simulated. Ignored when NODE_ENV=production, and
# ignored when Nebius is configured.
DEV_FIXTURE_AI=false
