# Copy this file to frontend/.env.local if you need to override defaults.
#
# IMPORTANT: every VITE_* variable is compiled into the public JavaScript bundle.
# Only the three variables below belong here. NEVER add SUPABASE_SECRET_KEY,
# NEBIUS_API_KEY, or any other secret to the frontend.

# Base URL of the EvidenceLoop API.
# Leave blank for local development (Vite proxies /api to http://localhost:4000).
# In production (Vercel) set it to your Render URL, e.g. https://evidenceloop-api.onrender.com
VITE_API_BASE_URL=

# Supabase project URL and PUBLISHABLE key (safe for browsers; protected by Row Level Security).
# Leave both blank for local development without sign-in.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
